# Circle API key (from https://console.circle.com)
CIRCLE_API_KEY=your_circle_api_key_here

# Circle entity secret (64 hex chars = 32 bytes)
# Generate with: python backend/scripts/generate_entity_secret.py
CIRCLE_ENTITY_SECRET=

# Arc Testnet RPC endpoint
ARC_TESTNET_RPC_URL=https://arc-testnet.drpc.org

# Arc chain ID
ARC_CHAIN_ID=201980

# USDC ERC-20 token address on Arc testnet
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Seller wallet address
SELLER_WALLET_ADDRESS=

# x402 Facilitator URL (verifies and settles payment authorizations)
# Default: Coinbase public facilitator. Replace with your own if self-hosting.
X402_FACILITATOR_URL=https://x402-facilitator.cdp.coinbase.com

# LLM provider keys
NVIDIA_API_KEY=

# API Keys
# API keys are generated through the dashboard and stored in PostgreSQL.
# No additional environment configuration needed for API key auth.
