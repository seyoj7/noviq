{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/health", "dest": "/api/index.py" },
    { "src": "/services", "dest": "/api/index.py" },
    { "src": "/run-service", "dest": "/api/index.py" },
    { "src": "/run", "dest": "/api/index.py" },
    { "src": "/wallet(.*)", "dest": "/api/index.py" },
    { "src": "/transactions/(.*)", "dest": "/api/index.py" },
    { "src": "/docs", "dest": "/api/index.py" },
    { "src": "/redoc", "dest": "/api/index.py" },
    { "src": "/openapi.json", "dest": "/api/index.py" },
    { "src": "/frontend/(.*)", "dest": "/frontend/$1" },
    { "src": "/(.*\\.css)", "dest": "/frontend/$1" },
    { "src": "/(.*\\.js)", "dest": "/frontend/$1" },
    { "src": "/(.*\\.html)", "dest": "/frontend/$1" },
    { "src": "/(.*\\.png)", "dest": "/frontend/$1" },
    { "src": "/assets/(.*)", "dest": "/frontend/assets/$1" },
    { "src": "/documentation.html", "dest": "/frontend/documentation.html" },
    { "src": "/docs.css", "dest": "/frontend/docs.css" },
    { "src": "/docs.js", "dest": "/frontend/docs.js" },
    { "src": "/", "dest": "/frontend/index.html" }
  ]
}
