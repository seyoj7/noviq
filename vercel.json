{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/services",
      "destination": "/api/index.py"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/run-service",
      "destination": "/api/index.py"
    },
    {
      "source": "/run",
      "destination": "/api/index.py"
    },
    {
      "source": "/transactions/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/wallet",
      "destination": "/api/index.py"
    },
    {
      "source": "/wallet/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/api-keys/:path*",
      "destination": "/api/index.py"
    }
  ]
}
